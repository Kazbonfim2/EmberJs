{
  "name": "ember-ui",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Design system em React - visual denso de software de desktop gamer, cor de destaque laranja.",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/index.css"
  },
  "files": ["dist"],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:lib": "tsc -p tsconfig.json --emitDeclarationOnly --outDir dist && bun build ./src/index.ts --outdir dist --target browser --format esm --external react --external react-dom",
    "pack:lib": "bun run build:lib && npm pack",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.0",
    "lenis": "^1.3.26",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
